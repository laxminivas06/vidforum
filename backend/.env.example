# VID Educational Management Platform - Backend Environment Config Example
# Copy this file to .env and replace the values with your actual credentials

PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD=[YOUR-PASSWORD]
DB_NAME=postgres
DB_SSL=true

# Security & JWT
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# ==========================================
# VID School AI Voice Agent Configuration
# ==========================================
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_DEFAULT_VOICE=priya
SARVAM_DEFAULT_LANGUAGE=te-IN

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=Singapore
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=+918047123456

# Face Attendance reference photos (optional; private Supabase Storage bucket).
# When unset, face templates are still saved and photos are simply not stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FACE_PHOTO_BUCKET=face-photos
