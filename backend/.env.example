# VID Educational Management Platform - Backend Environment Config Example
# Copy this file to .env and replace the values with your actual credentials

PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD=[YOUR-PASSWORD]
DB_NAME=postgres
DB_SSL=true

# Security & JWT
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# ==========================================
# VID School AI Voice Agent Configuration
# ==========================================
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_DEFAULT_VOICE=priya
SARVAM_DEFAULT_LANGUAGE=te-IN

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=Singapore
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=+918047123456

# Twilio Telephony Configuration (Optional / Alternative to Exotel)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TELEPHONY_PROVIDER=twilio

# Face Attendance reference photos (optional; private Supabase Storage bucket).
# When unset, face templates are still saved and photos are simply not stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FACE_PHOTO_BUCKET=face-photos

# Yantra AI Tutor — free-tier demo on the Gemini API (key from https://aistudio.google.com).
# Textbook PDFs and page images use SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above (bucket created automatically).
# GROQ_API_KEY above is used as the chat fallback when Gemini is busy.
TUTOR_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Shared AI requests per minute (keep at or under the free-tier limit)
TUTOR_RPM=10
# Per-student caps over a rolling 24 hours
TUTOR_DAILY_MESSAGES=30
TUTOR_DAILY_TESTS=5
TEXTBOOK_BUCKET=textbooks
